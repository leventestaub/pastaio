# Pastaio dev environment — copy to .env (gitignored) and fill in.
# Read by the backend (export these before starting uvicorn).

# Required when using groq backends (the default).
GROQ_API_KEY=gsk_replace_me

# Backend selection. Options: stub | ollama | groq
# Default if unset: stub for both (see app/clients/factory.py).
# CLI flags override these: -Stub forces stub, -Offline forces ollama.
PASTAIO_REASONING_BACKEND=groq
PASTAIO_VISION_BACKEND=groq

# Optional model overrides — defaults are fine.
# PASTAIO_GROQ_LLM_MODEL=qwen/qwen3.8-27b
# PASTAIO_GROQ_VLM_MODEL=qwen/qwen3.8-27b
# Chat falls back along this list when a model is rate-limited or out of daily quota.
# PASTAIO_GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Ollama overrides (only matter if PASTAIO_*_BACKEND=ollama).
# PASTAIO_OLLAMA_HOST=http://localhost:11434
# PASTAIO_OLLAMA_LLM_MODEL=qwen3.5:4b
# PASTAIO_OLLAMA_VLM_MODEL=qwen3-vl:4b

# Logging.
PASTAIO_DEV_LOG=1
PASTAIO_LOG_LEVEL=normal
PASTAIO_LOG_COLOR=1
