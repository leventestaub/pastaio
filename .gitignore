# ─── KB build artifacts ──────────────────────────────────────────
# pastaio-kb.db is reproduced by `python pastaio-kb/build.py`.
# Don't commit binary diffs; commit YAML sources instead.
pastaio-kb/pastaio-kb.db
pastaio-kb/*.db-journal
pastaio-app/assets/pastaio-kb.db

# Old/backup KBs that may have been generated experimentally.
*.db.bak
*.db.old

# ─── User data (must never ship) ─────────────────────────────────
# Created by the running app on-device; if it ever shows up in the
# repo something has gone very wrong.
pastaio-memory.db
*.memory.db
**/pastaio-memory.db*

# ─── Eval harness outputs ────────────────────────────────────────
# Per-run traces are noisy and platform-dependent. If you want to
# preserve a particular run's report.md as a portfolio artifact,
# add an explicit `git add -f` for that single file.
pastaio-eval/results/
pastaio-eval/known_recipes.json

